# ---------------------------------------------------------------- icons ---
class Icons:
    """Bundled Yaru PNGs, rendered crisply for the window's scale factor."""

    def __init__(self):
        self.scale = 1
        self.cache = {}

    def pixbuf(self, name, size):
        px = size * self.scale
        key = (name, px)
        if key not in self.cache:
            for folder in ("24x24@2x", "48x48@2x", "256x256"):
                source_size = {"24x24@2x": 48, "48x48@2x": 96, "256x256": 256}[folder]
                path = os.path.join(ICON_DIR, folder, name + ".png")
                if source_size >= px and os.path.exists(path):
                    break
            try:
                self.cache[key] = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, px, px, True)
            except GLib.Error:
                theme = Gtk.IconTheme.get_default()
                self.cache[key] = theme.load_icon(name, px, Gtk.IconLookupFlags.FORCE_SIZE)
        return self.cache[key]

    def surface(self, name, size):
        return Gdk.cairo_surface_create_from_pixbuf(self.pixbuf(name, size), self.scale, None)

    def image(self, name, size):
        return Gtk.Image.new_from_surface(self.surface(name, size))

    def flag(self, code, width):
        """Rounded flag (flag-icons, MIT) at width x 3/4 width."""
        px = width * self.scale
        key = ("flag:" + code, px)
        if key not in self.cache:
            source = os.path.join(ICON_DIR, "flags", f"{code}-{32 if px <= 32 else 64}.png")
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(source, px, px * 3 // 4, True)
            self.cache[key] = Gdk.cairo_surface_create_from_pixbuf(pixbuf, self.scale, None)
        return Gtk.Image.new_from_surface(self.cache[key])

    def avatar(self, user, size):
        """The account picture (clipped round), or Yaru's default avatar."""
        if not user.get("icon"):
            return self.image("avatar-default", size)
        key = ("avatar:" + user["icon"], size * self.scale)
        if key not in self.cache:
            try:
                px = size * self.scale
                picture = GdkPixbuf.Pixbuf.new_from_file_at_scale(user["icon"], px, px, False)
                surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, px, px)
                context = cairo.Context(surface)
                context.arc(px / 2, px / 2, px / 2, 0, 2 * math.pi)
                context.clip()
                Gdk.cairo_set_source_pixbuf(context, picture, 0, 0)
                context.paint()
                surface.set_device_scale(self.scale, self.scale)
                self.cache[key] = surface
            except Exception:
                return self.image("avatar-default", size)
        return Gtk.Image.new_from_surface(self.cache[key])



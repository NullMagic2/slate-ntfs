class RootSession:
    """One administrator helper for the whole session, started through
    pkexec at launch, so the password is asked only once."""

    def __init__(self):
        self.process = None
        self.lock = threading.Lock()

    @property
    def active(self):
        return os.geteuid() == 0 or (self.process is not None and self.process.poll() is None)

    def start(self):
        """Blocking (run in a thread). Returns None on success, else a reason."""
        if os.geteuid() == 0:
            return None
        try:
            process = subprocess.Popen(["pkexec", HELPER, "serve"], stdin=subprocess.PIPE,
                                       stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       text=True, bufsize=1)
        except FileNotFoundError:
            return "The pkexec program is not installed."
        line = process.stdout.readline()
        try:
            ready = json.loads(line).get("ready") if line else False
        except ValueError:
            ready = False
        if ready:
            self.process = process
            return None
        process.stdin.close()
        error = process.stderr.read().strip()
        process.wait()
        if process.returncode == 126:
            return "Authentication was cancelled."
        if "no authentication agent" in error.lower():
            return "No password dialog is available in this session."
        if process.returncode == 127 or "not authorized" in error.lower():
            return "Authentication failed."
        return error or _("The administrator helper stopped (status {status}).", status=process.returncode)

    def request(self, message):
        """Blocking. Returns the helper's result or raises RuntimeError."""
        if os.geteuid() == 0:
            if message.get("cmd") == "save":
                return core.save_and_apply(message["changes"])
            raise RuntimeError("unknown request")
        with self.lock:
            if not self.active:
                raise RuntimeError("administrator session ended")
            try:
                self.process.stdin.write(json.dumps(message) + "\n")
                self.process.stdin.flush()
                line = self.process.stdout.readline()
            except (OSError, ValueError) as error:
                raise RuntimeError(f"administrator session ended ({error})")
            if not line:
                raise RuntimeError("administrator session ended")
            reply = json.loads(line)
            if not reply.get("ok"):
                raise RuntimeError(reply.get("error") or "request failed")
            return reply["result"]

    def stop(self):
        process, self.process = self.process, None
        if process is not None:
            try:
                process.stdin.close()
                process.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                pass



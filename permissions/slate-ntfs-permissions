def auth_mode():
    """'root' where the target asks for the root password (Debian with a root
    password), else 'admin' (sudo-group members; Ubuntu and Mint lock root)."""
    try:
        return "root" if open("/etc/slate-ntfs/auth-mode").read().strip() == "root" else "admin"
    except OSError:
        return "admin"


def password():
    return _("the root password") if auth_mode() == "root" else _("an administrator password")


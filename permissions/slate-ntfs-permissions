class Model:
    """Saved policies, pending edits, and who gets what."""

    def __init__(self):
        self.drives, self.users, self.groups = [], [], []
        self.saved = {}       # uuid -> policy as stored (or the default)
        self.edits = {}       # uuid -> edited copy of the policy
        self.owner_hint = {}  # uuid -> uid the drive is opened for ("auto" owner)
        self.errors = []

    def load(self):
        self.drives = core.list_drives()
        self.users = core.list_users()
        self.groups = core.list_groups()
        self.saved, self.errors, self.owner_hint = {}, [], {}
        me = os.getuid()
        for drive in self.drives:
            try:
                policy = core.read_policy(drive["uuid"])
            except core.PolicyError as error:
                self.errors.append(str(error))
                policy = None
            self.saved[drive["uuid"]] = policy or core.default_policy()
            hint = core.drive_owner(drive)
            if hint is None and any(u["uid"] == me for u in self.users):
                hint = me
            self.owner_hint[drive["uuid"]] = hint
        known = {d["uuid"] for d in self.drives}
        self.edits = {uuid: e for uuid, e in self.edits.items() if uuid in known}

    # -------------------------------------------------------- lookups ---
    def policy(self, uuid, saved=False):
        return self.saved[uuid] if saved else self.edits.get(uuid, self.saved[uuid])

    def edit(self, uuid):
        if uuid not in self.edits:
            policy = self.saved[uuid]
            self.edits[uuid] = dict(policy, users=dict(policy["users"]))
        return self.edits[uuid]

    def owner(self, uuid, saved=False):
        policy = self.policy(uuid, saved)
        return policy["owner"] if policy["owner"] is not None else self.owner_hint.get(uuid)

    def group(self, uuid, saved=False):
        policy = self.policy(uuid, saved)
        if policy["group"] is not None:
            return policy["group"]
        owner = self.owner(uuid, saved)
        try:
            return pwd.getpwuid(owner).pw_gid if owner is not None else None
        except KeyError:
            return None

    def group_info(self, gid):
        return next((g for g in self.groups if g["gid"] == gid), None)

    def group_name(self, gid):
        if gid is None:
            return "the owner's group"
        info = self.group_info(gid)
        if info:
            return info["name"]
        try:
            return grp.getgrgid(gid).gr_name
        except KeyError:
            return f"group {gid}"

    def user_by_name(self, name):
        return next((u for u in self.users if u["name"] == name), None)

    def user(self, uid):
        return next((u for u in self.users if u["uid"] == uid), None)

    def in_group(self, uid, gid):
        user = self.user(uid)
        if user is None or gid is None:
            return False
        info = self.group_info(gid)
        if info and user["name"] in info["members"]:
            return True
        try:
            return pwd.getpwuid(uid).pw_gid == gid or user["name"] in grp.getgrgid(gid).gr_mem
        except KeyError:
            return False

    def strict_level(self, uuid, uid, saved=False):
        levels = core.effective_levels(self.policy(uuid, saved), self.owner_hint.get(uuid) or 0)
        return levels.get(uid, "none")

    def access(self, uuid, uid, saved=False):
        """(level, why) for one person, whatever the drive's mode."""
        policy = self.policy(uuid, saved)
        if policy["mode"] == "windows":
            return self.strict_level(uuid, uid, saved), _("Windows permissions")
        if uid == self.owner(uuid, saved):
            cls = "owner"
        elif self.in_group(uid, self.group(uuid, saved)):
            cls = "group"
        else:
            cls = "others"
        read, write, _execute = core.rwx_from_modes(policy["file_mode"], policy["dir_mode"])[cls]
        level = "none" if not read else "write" if write else "read"
        why = {"owner": _("as the owner"),
               "group": _("as a member of “{group}”", group=self.group_name(self.group(uuid, saved))),
               "others": _("as everyone else")}[cls]
        return level, why

    # -------------------------------------------------------- changes ---
    def _normal(self, uuid, saved):
        policy = self.policy(uuid, saved)
        if policy["mode"] == "windows":
            return ("windows", tuple(sorted((u["uid"], self.strict_level(uuid, u["uid"], saved))
                                            for u in self.users)))
        return ("desktop", self.owner(uuid, saved), self.group(uuid, saved),
                policy["file_mode"], policy["dir_mode"])

    def is_changed(self, uuid):
        return uuid in self.edits and self._normal(uuid, False) != self._normal(uuid, True)

    def user_changed(self, uuid, uid):
        return self.is_changed(uuid) and self.access(uuid, uid) != self.access(uuid, uid, True)

    def changed_drives(self):
        return [d for d in self.drives if self.is_changed(d["uuid"])]

    def change_count(self):
        return len(self.changed_drives())

    def set_mode(self, uuid, mode):
        self.edit(uuid)["mode"] = mode

    def set_level(self, uuid, uid, level):
        """Strict mode. Returns the uid demoted from full control, if any."""
        policy = self.edit(uuid)
        current = {u["uid"]: self.strict_level(uuid, u["uid"]) for u in self.users}
        demoted = None
        if level == "full":
            for other, value in current.items():
                if other != uid and value == "full":
                    current[other] = "write"
                    demoted = other
        current[uid] = level
        policy["users"] = current
        return demoted

    def set_rwx(self, uuid, cls, index, value):
        policy = self.edit(uuid)
        rwx = core.rwx_from_modes(policy["file_mode"], policy["dir_mode"])
        bits = list(rwx[cls])
        bits[index] = value
        if index == 1 and value:
            bits[0] = True          # writing needs reading
        if index == 0 and not value:
            bits[1] = False         # no reading, no writing
        rwx[cls] = tuple(bits)
        policy["file_mode"], policy["dir_mode"] = core.modes_from_rwx(rwx)

    def set_preset(self, uuid, key):
        preset = next(p for p in core.PRESETS if p[0] == key)
        policy = self.edit(uuid)
        policy["file_mode"], policy["dir_mode"] = preset[2], preset[3]

    def payload(self, uuid):
        policy = dict(self.policy(uuid))
        if policy["mode"] == "windows":
            policy["users"] = {u["uid"]: self.strict_level(uuid, u["uid"]) for u in self.users}
        return core.policy_to_json(policy)



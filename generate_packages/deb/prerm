#!/bin/sh
# Module: packaging.deb.prerm
# Purpose: Stop package services and remove generated integration before removal.
# Created: 2026-10-02
# Architecture: Dpkg invokes this adapter; systemd owns service shutdown and existing mounted
# volumes remain kernel-managed.

set -e
case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable --now slate-ntfs-session.service || true
            systemctl stop 'slate-ntfs-automount@*.service' || true
        fi
        # Remove only the entries generated by this adapter; leave mounts intact.
        if [ -f /etc/fstab ]; then
            sed -i '/# slate-ntfs-managed$/d' /etc/fstab
        fi
        dkms remove -m slate-ntfs -v 0.7.0 --all || true
        # Desktop shortcuts this package created (marked), and their "done" notes.
        getent passwd | while IFS=: read -r user _ uid _ _ home _; do
            [ "$uid" -ge 1000 ] 2>/dev/null && [ -d "$home" ] || continue
            rm -f "$home/.config/slate-ntfs/desktop-shortcut-done"
            for shortcut in "$home"/*/ntfs-permissions-manager.desktop; do
                [ -f "$shortcut" ] && grep -q '^X-Slate-NTFS-Shortcut=true$' "$shortcut" && rm -f "$shortcut"
            done
        done
        rm -rf /usr/src/slate-ntfs-0.7.0/kernel/rust/target /usr/src/slate-ntfs-0.7.0/ntfs_utils/target || true
        ;;
esac

#!/bin/sh
# Module: packaging.deb.postinst
# Purpose: Configure package integration after installation.
# Created: 2026-10-02
# Architecture: Dpkg invokes this adapter; it configures installed modules, policy helpers and
# desktop integration.

set -e
[ "$1" = configure ] || exit 0
. /etc/os-release
. /usr/lib/slate-ntfs/package-profile
if [ "$ID" != "$SLATE_TARGET_ID" ] || [ "$VERSION_ID" != "$SLATE_TARGET_VERSION_ID" ]; then
    echo "Slate NTFS package requires $SLATE_TARGET_ID $SLATE_TARGET_VERSION_ID (found $ID $VERSION_ID)" >&2
    exit 1
fi
# The permissions manager used to be a Python program kept in this folder;
# dpkg removes its files but not the bytecode Python wrote next to them.
rm -rf -- /usr/lib/slate-ntfs/__pycache__
# Retire DKMS registrations left by earlier package versions. Their prerm did
# not unregister on upgrade, and dpkg then deleted their dkms.conf, so any later
# dkms install fails with "Could not locate dkms.conf". Drop them directly: a
# normal "dkms remove" would need the missing dkms.conf, and it would also
# uninstall ntfs_rs.ko, which now belongs to this version.
if [ -d /var/lib/dkms/slate-ntfs ]; then
    for registered in /var/lib/dkms/slate-ntfs/*; do
        [ -e "$registered" ] || continue
        old_version=${registered##*/}
        case "$old_version" in 0.6.7-2|original_module|kernel-*) continue ;; esac
        [ -d "$registered" ] && [ ! -L "$registered" ] || continue
        echo "Removing stale DKMS registration slate-ntfs/$old_version"
        rm -rf -- "$registered"
    done
    # kernel-<ver>-<arch> links that pointed at a removed version now dangle.
    for link in /var/lib/dkms/slate-ntfs/kernel-*; do
        [ -L "$link" ] && [ ! -e "$link" ] && rm -f -- "$link"
    done
fi
# Build products that dpkg could not remove with an old package's source tree.
for stale in /usr/src/slate-ntfs-*; do
    [ -d "$stale" ] && [ "$stale" != /usr/src/slate-ntfs-0.6.7-2 ] || continue
    dpkg -S "$stale" >/dev/null 2>&1 && continue
    [ -f "$stale/dkms.conf" ] && continue
    rm -rf -- "$stale"
done
if ! dkms status -m slate-ntfs -v 0.6.7-2 | grep -q .; then
    dkms add -m slate-ntfs -v 0.6.7-2
fi
found=0
for headers in /lib/modules/*/build; do
    [ -f "$headers/Makefile" ] || continue
    version=${headers%/build}
    version=${version##*/}
    dkms build --force -m slate-ntfs -v 0.6.7-2 -k "$version"
    dkms install --force -m slate-ntfs -v 0.6.7-2 -k "$version"
    depmod -a "$version"
    found=1
done
if [ "$found" -eq 0 ]; then
    echo 'Slate NTFS needs matching installed linux-headers before installation' >&2
    exit 1
fi
# Use the new driver right away when no NTFS drive is open with the old one;
# otherwise mount.ntfs switches over once the last drive is closed.
if [ -r /sys/module/ntfs_rs/srcversion ] &&
   [ "$(cat /sys/module/ntfs_rs/srcversion)" != "$(modinfo -F srcversion ntfs_rs 2>/dev/null)" ] &&
   ! awk '$3 == "ntfsrs" { found = 1 } END { exit !found }' /proc/self/mounts; then
    if modprobe -r ntfs_rs 2>/dev/null && modprobe ntfs_rs 2>/dev/null; then
        echo "Loaded the updated ntfs_rs driver."
    fi
fi
# Ubuntu 26.04 installs the prebuilt userspace library from the package.
# Older profiles still rebuild it against their older libc.
if [ "${SLATE_PREBUILT_LIBRARY:-0}" != 1 ]; then
    module_source=/usr/src/slate-ntfs-0.6.7-2
    /bin/bash "$module_source/dkms-build.sh" --library-only
    triplet=$(gcc -dumpmachine)
    install -m 0755 "$module_source/ntfs_utils/target/release/libntfs_utils.so" "/usr/lib/$triplet/libntfs_utils.so.0"
fi
ldconfig
case "$SLATE_TARGET_ID" in
    ubuntu|linuxmint)
        if [ -f /etc/slate-ntfs/mount-root ] &&
           [ "$(cat /etc/slate-ntfs/mount-root)" = /mnt/media ]; then
            printf '/media\n' > /etc/slate-ntfs/mount-root
        fi
        ;;
esac
# NTFS Permissions: who authorizes changes, following each target's root
# convention. Ubuntu/Mint lock root and use sudo-group administrators. Debian
# uses the root password when root has one, otherwise sudo-group members.
root_has_password() {
    [ "$(passwd -S root 2>/dev/null | awk '{print $2}')" = P ]
}
case "$SLATE_TARGET_ID" in
    debian)
        if root_has_password; then auth_mode=root; admins='"unix-user:0"'
        else auth_mode=admin; admins='"unix-group:sudo"'; fi ;;
    *)  auth_mode=admin; admins='"unix-group:sudo", "unix-group:admin"' ;;
esac
polkit_version=$(pkaction --version 2>/dev/null | awk '{print $NF}')
polkit_rule=/etc/polkit-1/rules.d/49-slate-ntfs-permissions.rules
if [ -n "$polkit_version" ] && dpkg --compare-versions "$polkit_version" ge 0.106; then
    mkdir -p /etc/polkit-1/rules.d
    cat > "$polkit_rule" <<EOF
// Generated by slate-ntfs for $SLATE_TARGET_ID $SLATE_TARGET_VERSION_ID ($auth_mode password).
// Regenerated on upgrade and removed with the package.
polkit.addAdminRule(function(action, subject) {
    if (action.id == "org.slate-ntfs.permissions.save") {
        return [$admins];
    }
});
EOF
    chmod 0644 "$polkit_rule"
else
    # polkit 0.105 (Ubuntu 22.04, Mint 20.3/21.3, Debian 11) cannot scope
    # administrators to one action; the distribution's own setting applies.
    rm -f "$polkit_rule"
    auth_mode=admin
fi
printf '%s\n' "$auth_mode" > /etc/slate-ntfs/auth-mode
# Make the NTFS Permissions Manager and its icon show up in menus right away.
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
# NTFS Permissions Manager shortcut for people logged in right now (others get
# it at their next login from /etc/xdg/autostart). Never fails the install.
for run in /run/user/[0-9]*; do
    [ -S "$run/bus" ] || continue
    uid=${run##*/}
    [ "$uid" -ge 1000 ] 2>/dev/null || continue
    user=$(getent passwd "$uid" | cut -d: -f1)
    home=$(getent passwd "$uid" | cut -d: -f6)
    [ -n "$user" ] && [ -d "$home" ] || continue
    desktop_env=$(tr '\0' '\n' < "/proc/$(pgrep -u "$uid" -n -f 'gnome-shell|cinnamon|mate-session|xfce4-session|plasmashell' 2>/dev/null || echo 0)/environ" 2>/dev/null |
        sed -n 's/^XDG_CURRENT_DESKTOP=//p' | head -n 1)
    runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="$run" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$run/bus" XDG_CURRENT_DESKTOP="$desktop_env" \
        /usr/lib/slate-ntfs/desktop-shortcut >/dev/null 2>&1 || true
done
if [ -d /run/udev ]; then
    /usr/bin/ntfs-run --refresh-desktop-policy
fi
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable slate-ntfs-session.service
    if [ -d /run/systemd/system ]; then
        systemctl restart slate-ntfs-session.service
    fi
fi
update-initramfs -u -k all
echo 'Slate NTFS is installed for kernels with headers. Reboot to retire ntfs/ntfs3 modules.'

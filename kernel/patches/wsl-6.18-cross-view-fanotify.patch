+
+/* A snapshot avoids holding namespace/mount locks over a fanotify
+ * permission wait. The superblock is pinned by the original event path. */
+struct path *snapshot_super_mounts(struct super_block *sb, unsigned int *count)
+{
+    struct path *paths;
+    struct mount *m;
+    unsigned int n, capacity = 0;
+    for (;;) {
+        {
+            guard(mount_locked_reader)();
+            n = 0;
+            for (m = sb->s_mounts; m; m = m->mnt_next_for_sb) {
+                if (IS_ERR_OR_NULL(m->mnt_ns)) continue;
+                if (n == UINT_MAX) return ERR_PTR(-EOVERFLOW);
+                n++;
+            }
+        }
+        capacity = max(capacity, n);
+        paths = kcalloc(capacity ?: 1, sizeof(*paths), GFP_NOFS);
+        if (!paths) return ERR_PTR(-ENOMEM);
+        n = 0;
+        {
+            guard(mount_locked_reader)();
+            for (m = sb->s_mounts; m; m = m->mnt_next_for_sb) {
+                if (IS_ERR_OR_NULL(m->mnt_ns)) continue;
+                if (n == capacity) break;
+                paths[n++].mnt = mntget(&m->mnt);
+            }
+        }
+        if (!m) { *count = n; return paths; }
+        while (n) mntput(paths[--n].mnt);
+        kfree(paths);
+        if (capacity == UINT_MAX) return ERR_PTR(-EOVERFLOW);
+        capacity++;
+        cond_resched();
+    }
 }
 
